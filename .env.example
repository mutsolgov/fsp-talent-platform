# ==============================================================================
# FSP IT-Talent Platform — Шаблон переменных окружения (.env.example)
# Безопасные дефолтные значения для запуска в Docker Compose и демо жюри
# ==============================================================================

# База данных PostgreSQL
POSTGRES_DB=fsp_platform
POSTGRES_USER=fsp_user
POSTGRES_PASSWORD=fsp_secret_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Строки подключения к базе данных (для Docker Compose: host='db')
# Для локального запуска вне Docker: заменить host 'db' на 'localhost' (@localhost:5432) или использовать sqlite
DATABASE_URL=postgresql+asyncpg://fsp_user:fsp_secret_dev@db:5432/fsp_platform
SYNC_DATABASE_URL=postgresql+psycopg://fsp_user:fsp_secret_dev@db:5432/fsp_platform
# Примеры для локального запуска без Docker:
# DATABASE_URL=postgresql+asyncpg://fsp_user:fsp_secret_dev@localhost:5432/fsp_platform
# SYNC_DATABASE_URL=postgresql+psycopg://fsp_user:fsp_secret_dev@localhost:5432/fsp_platform
# Или SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./fsp_talent.db
# SYNC_DATABASE_URL=sqlite:///./fsp_talent.db

# Безопасность и JWT
SECRET_KEY=fsp_dev_super_secret_jwt_key_2026_jury_eval
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# Криптографические ключи генерации вариантов и подписи вебхуков
HMAC_SECRET_KEY=fsp_hmac_isomorphic_seed_key_2026
WEBHOOK_SIGNING_SECRET=fsp_ats_webhook_secret_key_2026

# Бизнес-параметры
COOLDOWN_DAYS=30
DEMO_BYPASS_ENABLED=True
OFFLINE_MODE=True

# Keycloak 26 OIDC
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_fsp_secret_2026
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
KEYCLOAK_EXTERNAL_URL=/auth
KEYCLOAK_REALM=fsp-realm
KEYCLOAK_CLIENT_ID=fsp-frontend

# Порты сервисов
FRONTEND_PORT=80
BACKEND_PORT=8000
KEYCLOAK_PORT=8080
