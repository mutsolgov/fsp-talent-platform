{
  "realm": "fsp-realm",
  "displayName": "Федерация спортивного программирования РФ",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Федерация спортивного программирования РФ</span></div>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "candidate",
        "description": "Соискатель платформы ФСП"
      },
      {
